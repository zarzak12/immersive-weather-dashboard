{
  "name": "immersive-weather-dashboard",
  "version": "1.0.2",
  "description": "A full-screen, procedurally animated Home Assistant weather Lovelace card with a graphical editor.",
  "type": "module",
  "license": "MIT",
  "author": "Immersive Weather Dashboard contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/zarzak12/immersive-weather-dashboard.git"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
